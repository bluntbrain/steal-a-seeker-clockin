{
  "expo": {
    "name": "Steal a Seeker",
    "slug": "steal-a-seeker-mvp",
    "version": "0.3.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.krane.stealaseeker.mvp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#08A899"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Steal a Seeker \u00b7 Night Shift"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "baseUrl": ""
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
