{
  "expo": {
    "name": "Steal a Seeker",
    "slug": "steal-a-seeker-mvp",
    "version": "0.3.32",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.bluntbrain.stealaseeker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#08A899"
      },
      "versionCode": 35,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Steal a Seeker \u00b7 Night Shift"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "baseUrl": ""
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-video"
    ]
  }
}
