{
  "name": "steal-a-seeker-mvp",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "npm run rules:check && expo export --platform web && node scripts/build-sheet-preview.cjs && node scripts/build-paywall-preview.cjs && node scripts/copy-design.cjs",
    "build:apk": "npm run rules:check && cd android && ./gradlew :app:cleanCreateBundleReleaseJsAndAssets :app:assembleRelease --no-daemon",
    "preview": "node scripts/preview.cjs",
    "server:dev": "tsx server/main.ts",
    "server:test": "tsx --test server/*.test.ts",
    "rules:generate": "tsx scripts/rules-manifest.ts",
    "rules:check": "tsx scripts/rules-manifest.ts --check"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@react-three/fiber": "9.7.0",
    "@shopify/react-native-skia": "2.4.18",
    "@solana-program/memo": "^0.13.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@solana/wallet-standard-util": "^1.1.4",
    "@wallet-ui/react-native-kit": "^4.3.0",
    "expo": "~55.0.31",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-gl": "~55.0.18",
    "expo-haptics": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "fastify": "^5.12.4",
    "js-base64": "^3.9.3",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "three": "0.180.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.0",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
