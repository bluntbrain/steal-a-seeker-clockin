# Public configuration only; never put signing keys here.
EXPO_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com
# Development identity. Replace with the game's owned release website before shipping.
EXPO_PUBLIC_APP_IDENTITY_URI=https://github.com/bluntbrain

# Set a reachable HTTPS commerce API before building the native shop.
EXPO_PUBLIC_API_URL=https://seeker-api-production-41b3.up.railway.app

# Camera presentation only. Set 0 and rebuild to restore the original full map.
EXPO_PUBLIC_FOLLOW_CAMERA=1
# Size multiplier; default 1.3, allowed 1.0–1.6.
EXPO_PUBLIC_CAMERA_ZOOM=1.3

# Android collectible inspector. Rebuild APK after changing; web keeps Three.js.
# Use turntable to restore the image-based compatibility viewer.
EXPO_PUBLIC_PHONE_RENDERER=filament

# Presentation only: flat (previous), subtle (default), strong.
EXPO_PUBLIC_WALL_DEPTH=subtle
